# MCP is configured by DSH, not by this plugin. Register streamable-http server chatbi-databuff in DSH MCP settings.
# Authentication is enabled by default. Set false only for isolated local tests.
DATABUFF_AUTH_REQUIRED=true

# The Settings and Plugins surfaces are visible by default. Set true to hide them.
DATABUFF_DSH_UI_LOCKED=true
# Unlocks admin surfaces; workspace picking stays locked if the hide switch is true.
DATABUFF_DSH_ADMIN_MODE=true

# Hide workspace creation/picking and force sessions into the configured default workspace.
# This explicit setting takes precedence over DATABUFF_DSH_ADMIN_MODE.
DATABUFF_DSH_HIDE_ADD_WORKSPACE=true

# Browser-visible endpoint. It must return 2xx only for a valid DataBuff login.
DATABUFF_AUTH_STATUS_URL=/webapi/api/v1/dsh/auth/status
DATABUFF_LOGIN_URL=/databuff/login
DATABUFF_DSH_REDIRECT_URL=/ai/

# HTML report output directory. Absolute paths are used directly; relative paths
# are resolved from each session workspace. Defaults to workspace/databuff-reports.
DATABUFF_DSH_REPORT_DIR=

# Browser-visible DSH base URL. Override if the public DSH URL differs.
DATABUFF_DSH_REPORT_PUBLIC_BASE_URL=https://opt.beta.uletm.com/dsh
