# MCP is configured by DSH, not by this plugin. Register streamable-http server chatbi-databuff in DSH MCP settings.
# true in production; false only for isolated development/test deployments.
DATABUFF_AUTH_REQUIRED=false

# Browser-visible endpoint. It must return 2xx only for a valid DataBuff login.
DATABUFF_AUTH_STATUS_URL=/webapi/api/v1/dsh/auth/status
DATABUFF_LOGIN_URL=/databuff/login
DATABUFF_DSH_REDIRECT_URL=/ai/
