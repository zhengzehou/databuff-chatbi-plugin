{
  "name": "@databuff/dsh-plugin-chatbi",
  "version": "0.1.3",
  "private": true,
  "description": "Restricted DataBuff APM ChatBI agent for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./workspace-policy": {
      "types": "./lib/workspace-policy.d.ts",
      "default": "./lib/workspace-policy.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-alpha.1": "compatible",
        "0.1.7-alpha.2": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "preset",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-mcp-client": "0.1.7-alpha.1 || 0.1.7-alpha.2",
    "@deepseek-ai/dsh-persona": "0.1.7-alpha.1 || 0.1.7-alpha.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.7-alpha.1 || 0.1.7-alpha.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.7-alpha.1 || 0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1 || 0.1.7-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-persona": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
